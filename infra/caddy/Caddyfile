{
  servers {
    protocols h1 h2
  }
}
meet.babagan.cloud {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(self), display-capture=(self)"
  }

  handle /api/* {
    reverse_proxy api:3000
  }

  handle /health/* {
    reverse_proxy api:3000
  }

  # Keep LiveKit signaling on the public meeting origin. This route is
  # WebSocket-compatible through Cloudflare, while media still uses the
  # DNS-only LiveKit/TURN endpoints advertised by the server.
  handle /rtc* {
    reverse_proxy host.docker.internal:7880
  }

  handle {
    reverse_proxy web:8080
  }
}

rtc.babagan.cloud {
  reverse_proxy host.docker.internal:7880
}
