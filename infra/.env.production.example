# Copy to infra/.env.production, replace every placeholder, and set mode 600.
PUBLIC_BASE_URL=https://meet.babagan.cloud
NODE_IMAGE=node:24.15.0-alpine3.23@sha256:d1b3b4da11eefd5941e7f0b9cf17783fc99d9c6fc34884a665f40a06dbdfc94f
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
NPM_REGISTRY=https://registry.npmmirror.com
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
LIVEKIT_URL=wss://rtc.babagan.cloud
LIVEKIT_INTERNAL_URL=ws://host.docker.internal:7880
LIVEKIT_IMAGE=livekit/livekit-server:v1.11.0@sha256:100b9a870616d02f5e3795b34e0b593b5054a26f8131a94fd3fa322ed3154b16
LIVEKIT_NODE_IP=203.0.113.10
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
ADMIN_PASSWORD_HASH=replace-with-argon2id-password-hash
COOKIE_SECRET=replace-with-a-random-cookie-secret-of-at-least-32-bytes
P2P_STUN_URLS=stun:stun.example.com:3478
P2P_TURN_URLS=turn:turn.babagan.cloud:3478?transport=udp,turn:turn.babagan.cloud:3478?transport=tcp,turns:turn.babagan.cloud:5349?transport=tcp
P2P_TURN_SECRET=replace-with-the-same-random-secret-used-by-coturn
P2P_TURN_TTL_SECONDS=600
# Uncomment and configure these after creating the server-side Cloudflare TURN key and API token.
P2P_TURN_PROVIDER=coturn
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# CLOUDFLARE_TURN_TTL_SECONDS=600
# CLOUDFLARE_TURN_CONNECT_IPS=
COTURN_IMAGE=coturn/coturn:4.17.2-r0@sha256:aa68aab64a3b929d57fc2924c98ea447bf996cf8dade2508e7b71eaf23f1f14e
TURN_SHARED_SECRET=replace-with-the-same-random-secret-used-by-the-api
TURN_EXTERNAL_IP=203.0.113.10
TURN_RELAY_IP=10.0.0.8
