{
  "name": "@meeting/api",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @meeting/contracts build",
    "pretest": "pnpm --filter @meeting/contracts build",
    "pretypecheck": "pnpm --filter @meeting/contracts build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --project api",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@meeting/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "~0.34.52",
    "argon2": "~0.44.0",
    "async-mutex": "~0.5.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.11.2",
    "livekit-server-sdk": "^2.17.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.23.11"
  }
}
